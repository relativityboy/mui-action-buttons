{
  "name": "@relativity/mui-action-buttons",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./llms.txt": "./llms.txt",
    "./docs/agents.md": "./docs/agents.md",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.mjs",
    "dist/index.mjs.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/AIconButton.d.ts",
    "dist/AIconButton.d.ts.map",
    "dist/styles.css",
    "llms.txt",
    "docs/agents.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup -c && cp src/styles.css dist/styles.css",
    "test": "jest",
    "test:package": "npm run build && node --test tests/package.test.mjs",
    "test:publish": "node --test tests/publish.test.mjs",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "storybook:install-browser": "playwright install chromium",
    "test:storybook": "vitest run --project storybook",
    "test:storybook:watch": "vitest --project storybook",
    "site": "vite --config vite.config.site.ts --host 127.0.0.1 --port 4173 --strictPort",
    "build:site": "vite build --config vite.config.site.ts && storybook build --output-dir site-dist/storybook && node scripts/finalize-site.mjs",
    "preview:site": "vite preview --config vite.config.site.ts --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck:site": "tsc --noEmit -p tsconfig.site.json",
    "test:site": "node --test tests/site.test.mjs"
  },
  "keywords": ["react", "mui", "material-ui", "async", "button", "typescript"],
  "author": "",
  "license": "ISC",
  "description": "Async action buttons for React and MUI with pending, success, and dismissible error feedback.",
  "homepage": "https://relativityboy.github.io/mui-action-buttons/",
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.4.8",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "jest": "^30.0",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.36.0",
    "storybook": "^10.6.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths-jest": "^0.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/relativityboy/mui-action-buttons.git"
  }
}
